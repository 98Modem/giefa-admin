NEXT_PUBLIC_SITE_URL=https://giefa.org
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Auth redirect URLs should include:
# https://giefa.org/auth/callback
# https://www.giefa.org/auth/callback
# http://localhost:3000/auth/callback

GIEFA_OCR_PROVIDER=google-vision
GOOGLE_CLOUD_VISION_API_KEY=

GEMINI_API_KEY=
GEMINI_FINANCE_REPORT_MODEL=gemini-flash-latest
GEMINI_GIEFA_ASSISTANT_MODEL=gemini-flash-latest

# Optional fallback AI provider.
OPENAI_API_KEY=
OPENAI_DEPOSIT_EXTRACTION_MODEL=gpt-4o-mini
OPENAI_FINANCE_REPORT_MODEL=gpt-4o-mini
OPENAI_GIEFA_ASSISTANT_MODEL=gpt-4o-mini
